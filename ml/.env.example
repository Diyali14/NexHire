LM_STUDIO_BASE_URL=https://desktop-ia8r1dm.tail05ff3e.ts.net/v1/models
LM_STUDIO_URL=https://desktop-ia8r1dm.tail05ff3e.ts.net/v1/chat/completions
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_TIMEOUT=180

# Optional legacy text/OCR provider. LM Studio remains the structured parser.
UNSTRUCTURED_ENABLED=false
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://platform-api.transform.unstructured.io/api/v1

# ── Gemini fallback (optional — used automatically if LM Studio is unreachable) ─
# Leave blank to disable. When set, any LM Studio connection failure will retry
# transparently with Gemini. No code changes needed to activate.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
